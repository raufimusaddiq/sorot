{
  "name": "sorot",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "cli"
  ],
  "scripts": {
    "dev": "bun run --filter sorot-backend dev",
    "dev:web": "bun run --filter sorot-frontend dev",
    "build": "bun run --filter sorot-frontend build",
    "start": "bun run --filter sorot-backend start",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter sorot-backend --filter sorot-cli typecheck",
    "sorot": "bun run cli/src/main.ts"
  }
}
