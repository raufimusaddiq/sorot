{
  "name": "camera",
  "version": "1.0.0",
  "does": "Moves a camera over the shot (pan, zoom, dolly) in any projection: flat, perspective or isometric.",
  "runtime": "dom",
  "needs": { "gpu": "no" },
  "settings": {
    "move": { "t": "enum", "values": ["none", "pan-left", "pan-right", "pan-up", "pan-down", "zoom-in", "zoom-out", "dolly-in", "dolly-out"] },
    "amount": { "t": "num", "min": 0, "max": 1 },
    "projection": { "t": "enum", "values": ["flat", "perspective", "isometric"] },
    "ease": { "t": "enum", "values": ["travel", "arrive", "linear"] },
    "target": { "t": "str", "max": 120 }
  },
  "defaults": { "move": "dolly-in", "amount": 0.3, "projection": "flat", "ease": "travel", "target": "" },
  "example": "An isometric city block the camera dollies into: {\"projection\": \"isometric\", \"move\": \"dolly-in\"}."
}
