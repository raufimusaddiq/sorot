{
  "name": "iso",
  "version": "1.0.0",
  "does": "An isometric 3D diorama (Three.js, orthographic camera, soft shadows): blocks, coin stacks, bars, cylinders, spheres, houses and trees on a floor grid, rising in one by one.",
  "runtime": "webgl",
  "needs": { "gpu": "preferred" },
  "settings": {
    "items": {
      "t": "list", "max": 24,
      "item": {
        "t": "obj", "required": ["kind"],
        "fields": {
          "kind": { "t": "enum", "values": ["block", "coins", "bar", "cylinder", "sphere", "cone", "tile", "house", "tree"] },
          "x": { "t": "num", "min": -6, "max": 6 },
          "z": { "t": "num", "min": -6, "max": 6 },
          "height": { "t": "num", "min": 0.1, "max": 8 },
          "size": { "t": "num", "min": 0.2, "max": 4 },
          "color": { "t": "str", "max": 30 }
        }
      }
    },
    "floor": { "t": "enum", "values": ["none", "plain", "grid"] },
    "camera": { "t": "enum", "values": ["static", "turn", "zoom-in"] },
    "zoom": { "t": "num", "min": 0.3, "max": 3 },
    "grow": { "t": "enum", "values": ["rise", "pop", "none"] },
    "stagger": { "t": "num", "min": 0, "max": 1 },
    "y": { "t": "num", "min": 0, "max": 1 }
  },
  "defaults": { "items": [{ "kind": "block" }], "floor": "plain", "camera": "static", "zoom": 1, "grow": "rise", "stagger": 0.12, "y": 0.6 },
  "example": "A growing bar chart of coin stacks: {\"items\": [{\"kind\": \"coins\", \"x\": -2, \"height\": 1}, {\"kind\": \"coins\", \"x\": 0, \"height\": 2.5}, {\"kind\": \"coins\", \"x\": 2, \"height\": 5}], \"floor\": \"grid\"}."
}
