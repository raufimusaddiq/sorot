{
  "name": "text-reveal",
  "version": "1.0.0",
  "does": "Reveals text already in the markup by word, character or line: rise from a mask, fade, or type on.",
  "runtime": "dom",
  "needs": { "gpu": "no" },
  "settings": {
    "target": { "t": "str", "max": 120 },
    "by": { "t": "enum", "values": ["word", "char", "line"] },
    "style": { "t": "enum", "values": ["rise", "fade", "mask", "type"] },
    "at": { "t": "num", "min": 0, "max": 90 },
    "stagger": { "t": "num", "min": 0, "max": 1 },
    "length": { "t": "num", "min": 0.1, "max": 5 }
  },
  "defaults": { "target": "", "by": "word", "style": "mask", "at": 0, "stagger": 0.06, "length": 0.6 },
  "example": "A title rising word by word from a mask: {\"target\": \"h1\", \"by\": \"word\", \"style\": \"mask\"}."
}
