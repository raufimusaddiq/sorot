# Copy to .env.llm (gitignored) for keys; Docker loads it next to .env.docker.
# Ollama needs no key. Settings (URL, model) are in .env.docker.
# All three can also be set in the app (Settings) or with `sorot connect`.
LLM_API_KEY=
# Jev quality gate (https://docs.typesafe.ai). Empty = the rules answer the gate's questions.
JEV_API_KEY=
# Publishing via Tebar (https://docs.tebar.app/api, paid plan). Empty = no publishing.
TEBAR_API_KEY=
