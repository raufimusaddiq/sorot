# Environment Variables — DOCKER overrides
# Usage: docker compose --env-file .env.docker up

# --- Image ---
# Tag of ghcr.io/raufimusaddiq/sorot to run: latest (newest release) or a release version, e.g. 1.2.0
SOROT_VERSION=latest

# --- Python ---
PYTHON_PATH=/app/ai-pipeline/.venv/bin/python3

# --- Pipeline ---
PIPELINE_DIR=/app/ai-pipeline

# --- AI Pipeline ---
WHISPER_MODEL=large-v3-turbo
# cpu here; the GPU compose override sets cuda (with the -cuda image).
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=id

# --- External Tools ---
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# --- Captions / editing ---
# Caption preset: default | hormozi | storyteller | cinematic
SUBTITLE_STYLE=default
# Cut pauses longer than SILENCE_GAP_SEC out of every clip (video, audio and
# captions stay in sync). Opt-in: set to true for jump-cut style clips.
SILENCE_TRIM=false
SILENCE_GAP_SEC=0.6
# 9:16 framing: face (crop follows faces, centre crop when none found)
# | center | blur (whole frame over a blurred fill, for wide group shots)
REFRAME_MODE=face
# Replay each clip's strongest line before it starts.
HOOK_FIRST=false
# Use the video's uploaded YouTube captions instead of Whisper when present
# (YOUTUBE_AUTO_CAPTIONS=true also accepts auto-generated ones).
YOUTUBE_CAPTIONS=false
YOUTUBE_AUTO_CAPTIONS=false
# Default background music: a file name in data/music (empty = none).
BGM_FILE=
BGM_VOLUME=0.12
# Zoom-preset copies of the top clips (VARIATION stage). Off: nothing in the
# app shows them yet, and they cost extra encodes per video.
VARIATIONS=false

# --- CPU tuning ---
# libx264 preset when there's no NVENC: veryfast (default) | faster | fast…
# fast: slightly better quality (~0.4 dB) at ~2x the encode time.
X264_PRESET=veryfast
# Whisper CPU threads; empty = every core (faster-whisper alone uses 4).
WHISPER_THREADS=
# Whisper beam size; empty = 5. 1 is faster on a CPU, a little less accurate.
WHISPER_BEAM_SIZE=
# Best clips rendered per video; the rest are listed and render on request
# (Render button). Empty = 10 on a CPU, all on a GPU; 0 = all.
MAX_RENDER_CLIPS=
# Videos processed at once (others queue). Empty = 1 on a CPU (every stage
# already uses all cores), 2 on a GPU.
MAX_CONCURRENT_PIPELINES=

# --- Scoring ---
NICHE_KEYWORDS=rahasia,penting,trik,solusi,tip

# --- LLM (optional) ---
# Any OpenAI-compatible endpoint. Empty = no LLM: clips are scored by the
# rules and auto-discover uses the algorithm. With one, it also reviews clips
# (50/50 with the rules, writes titles) and runs the auto-discover agent.
#   Ollama on this machine: LLM_BASE_URL=http://host.docker.internal:11434/v1
#                           LLM_MODEL=qwen2.5:7b
#   Groq / OpenRouter / OpenAI: their /v1 URL and a model name; put the key
#   in .env.llm (LLM_API_KEY=..., gitignored), never in this file.
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=120
# Web search for auto-discover: bing (no key) | a SearXNG URL | off
WEB_SEARCH=bing

# --- Paths ---
DATA_DIR=/app/data

# --- Server ---
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000
