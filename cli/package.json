{
  "name": "viralclip-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": { "vclip": "src/main.ts" },
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify src/main.ts --outfile dist/vclip"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
